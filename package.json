{
  "name": "@aliou/pi-synthetic",
  "version": "0.31.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-synthetic"
  },
  "pi": {
    "extensions": [
      "./extensions/provider/index.ts",
      "./extensions/web-search/index.ts",
      "./extensions/command-quotas/index.ts",
      "./extensions/quota-warnings/index.ts",
      "./extensions/usage-status/index.ts"
    ],
    "video": "https://assets.aliou.me/github/aliou/pi-synthetic/demo.mp4",
    "image": "https://assets.aliou.me/github/aliou/pi-synthetic/banner.png"
  },
  "sideEffects": false,
  "exports": {
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js"
    },
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "import": "./dist/durable/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "schema.json",
    "CHANGELOG.md",
    "README.md",
    "!src/**/*.test.ts",
    "!extensions/**/*.test.ts"
  ],
  "peerDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "typebox": "*"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "pi-settings-schema -p src/config.ts -t SyntheticConfig -o schema.json",
    "check:schema": "pnpm gen:schema --check",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm changeset publish"
  },
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.24.0",
    "@aliou/pi-utils-ui": "^0.5.1"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.16.0",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^2.27.11",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "^25.0.10",
    "husky": "^9.1.7",
    "ts-json-schema-generator": "^2.9.0",
    "tsdown": "^0.23.4",
    "tsx": "^4.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependenciesMeta": {
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.27.0"
}
