{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SyntheticConfig",
  "definitions": {
    "SyntheticConfig": {
      "type": "object",
      "properties": {
        "configVersion": {
          "type": "string"
        },
        "api": {
          "$ref": "#/definitions/SyntheticApi",
          "description": "Which API serves model requests. Changes require a reload."
        },
        "webSearch": {
          "type": "boolean"
        },
        "quotasCommand": {
          "type": "boolean"
        },
        "usageStatus": {
          "type": "boolean"
        },
        "quotaWarnings": {
          "type": "boolean"
        },
        "subBarIntegration": {
          "type": "boolean"
        },
        "proxyUrl": {
          "type": "string"
        },
        "proxyRequiresAuth": {
          "type": "boolean"
        },
        "$schema": {
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\d{1,15}(\\.\\d{1,15})?(\\.\\d{1,15})?$"
            }
          ],
          "description": "Config schema version, stamped by migrations. Current version: 0.25.0."
        }
      },
      "additionalProperties": false
    },
    "SyntheticApi": {
      "type": "string",
      "enum": [
        "openai-completions",
        "anthropic-messages"
      ],
      "description": "Synthetic serves every chat model twice: on an OpenAI-compatible `/openai/v1` endpoint and on an Anthropic-compatible `/anthropic` endpoint. Exactly one serves the provider at a time."
    }
  }
}
